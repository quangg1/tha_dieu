# Postgres connection string (Vercel adds this when you connect a Neon database).
DATABASE_URL=
# Referee for answers the village book does not know. Claude is used when its key is set, otherwise Gemini.
# With neither, unknown answers ask the player to try another one (and go to the review queue).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Long random string for /#admin and the database setup call.
ADMIN_TOKEN=
